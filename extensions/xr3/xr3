@cli.command(name="dev-cleanup")
@click.option('--force/--no-force', '-f', default=False,
              help="Force cleanup even if uncommitted/unpushed changes are detected")
@click.option('--ignore-untracked/--no-ignore-untracked', default=False,
              help="Ignore untracked files when checking for clean state")
@click.argument("path", type=click.Path(exists=True, file_okay=False, path_type=Path))
@click.argument(
    "repository_path",
    type=click.Path(exists=True, file_okay=False, path_type=Path),
    envvar="R3_REPOSITORY",
)
def dev_cleanup(force: bool, ignore_untracked: bool, path: str, repository_path: str) -> None:
    job = r3.Job(path)
    repository = r3.Repository(repository_path)
    if job in repository:
        print("ERROR: Can only dev cleanup jobs that are not committed.")
        sys.exit(1)

    # Check git dependencies before cleanup
    all_clean, results = _check_git_dependencies(job, Path(path), repository)

    # Apply ignore_untracked filter if requested
    if ignore_untracked:
        for result in results:
            if result.is_checked_out and result.has_untracked:
                # Remove untracked-related issues
                result.issues = [i for i in result.issues if "untracked" not in i.lower()]
                result.has_untracked = False
                # Recalculate is_clean
                result.is_clean = len(result.issues) == 0
        all_clean = all(r.is_clean for r in results if r.is_checked_out)

    has_checked_out_git_deps = any(r.is_checked_out for r in results)

    if has_checked_out_git_deps:
        _format_git_check_results(results)

        if not all_clean:
            print("WARNING: Some git dependencies have uncommitted or unpushed changes!")
            print("These changes will be LOST if you proceed with cleanup.")
            print()
            if not force:
                print("Aborting. Use --force to override this check.")
                sys.exit(1)
            else:
                print("--force specified, proceeding with cleanup...")
                print()

    for dependency in job.dependencies:
        print(dependency.destination)

        target_path = Path(path) / dependency.destination
        if target_path.exists(follow_symlinks=False):
            if target_path.is_symlink():
                print("removing link", target_path)
                target_path.unlink()
            elif target_path.is_file():
                print("removing file", target_path)
                target_path.unlink()
            elif target_path.is_dir():
                print("removing directory", target_path)
                shutil.rmtree(target_path)

            while target_path.parent != path:
                if not list(target_path.parent.iterdir()):
                    print("Cleaning up", target_path.parent)
                    target_path.parent.rmdir()
                    target_path = target_path.parent
                else:
                    break

    for other_directory in ['output', '__pycache__']:
        target_path = Path(path) / other_directory

        if target_path.is_dir():
            print("removing directory", target_path)
            shutil.rmtree(target_path)


