    repository = r3.Repository(repository_path)

    job = r3.Job(path)
    job = repository.resolve(job)

    missing_dependencies = []
    for dependency in job.dependencies:
        if dependency not in repository:
            print(f"Error: Missing dependency: {dependency}")
            print("destination:", dependency.destination)
            missing_dependencies.append(dependency)

    if missing_dependencies:
            sys.exit(1)

    buggy_dependencies = []
    for dependency in job.dependencies:
        if isinstance(dependency, r3.JobDependency):
            resolved_dependency = repository.resolve(dependency)
            dependency_job = r3.Job(repository.path / 'jobs' / resolved_dependency.job)
            tags = dependency_job.metadata.get("tags", [])
            bug_tags = [tag for tag in tags if tag.startswith("bug/")]
            if bug_tags:
                print(f"Bugged dependency for {dependency.destination}:")
                for tag in bug_tags:
                    print(f"- {tag}")
                buggy_dependencies.append(dependency)
    if buggy_dependencies and not allow_bugs:
        print("Bugged dependencies detected, aborting. Continue with --allow-bugs")
        sys.exit(1)

    for dependency in job.dependencies:
        if str(dependency.destination) in IGNORED_DESTINATIONS:
