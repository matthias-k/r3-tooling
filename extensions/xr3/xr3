@click.argument(
    "repository_path",
    type=click.Path(exists=True, file_okay=False, path_type=Path),
    envvar="R3_REPOSITORY",
)
def commit(remove_previous, copy_previous_output, exclude_done, submit: bool, observe: bool, check: bool, path, repository_path):
    if check:
        correct = _check_job(path, repository_path)
        if not correct:
            print("Job has inconsistencies. Aborted commit, run with --no-check to commit anyway.")
            sys.exit(1)

    repository = r3.Repository(repository_path)
    job = r3.Job(path)

    job = repository.resolve(job)


    previous_job: Optional[r3.Job] = None
    if remove_previous or copy_previous_output:
        print("looking up previous job")
        history = _history(latest=True, path=path, repository_path=repository_path)
        if not history:
            raise ValueError(f"No previous job found for {path}")
        previous_job = history[0]
        print(f"previous job: {previous_job.id} {previous_job.timestamp}")

    print("Commiting")
    job = repository.commit(job)
    print(job.path)

    if copy_previous_output:
        print("copying previous output")
        assert previous_job is not None
        previous_output = previous_job.path / "output"
        output = job.path / "output"
        output.mkdir(exist_ok=True)

        for item in previous_output.iterdir():
            if exclude_done and item.name == "done":
                print("skipping done file")
                continue
            if item.is_dir():
                print("Copying directory", item)
                shutil.copytree(item, output / item.name)
            else:
                print("Copying file", item)
                shutil.copy2(item, output / item.name)

    if remove_previous:
        assert previous_job is not None
        print("deleting previous job", previous_job.path)
        repository.remove(previous_job)

    if submit:
        print("Submitting job")
        _submit_job(job.path, dry=False, check_existing_jobs=False, restart_failed=False, observe=observe, cluster='galvani')


