def _check_job(path, repository, check_git: bool = True):
    correct = True
    repository: r3.Repository = r3.Repository(repository)
    job: r3.Job = r3.Job(path)
    job = repository.resolve(job)  # type: ignore
    for dependency in job.dependencies:
        if isinstance(dependency, r3.JobDependency):
            depending_job = dependency.job

            if not isinstance(depending_job, r3.Job):
                depending_job = r3.Job(repository.path / "jobs" / depending_job)

            for tag in depending_job.metadata.get("tags", []):
                if any(tag.startswith(p) for p in _config()["blockers"]["tags"]):
                    print(f"ERROR: Dependency {dependency} has bug tag '{tag}'.")
                    correct = False
        if dependency not in repository:
            print(f"Error: Missing dependency: {dependency}")
            print("destination:", dependency.destination)
            correct = False


    expected_path = _get_path(path)
    if 'origin' in job.metadata and job.metadata['origin'] != expected_path:
        print(f"ERROR: Origin mismatch)")
        print(f"   {job.metadata['origin']}")
        print(f"!= {expected_path}")
        correct = False

    if job.metadata['path'] != expected_path:
        print(f"ERROR: Path mismatch)")
        print(f"   {job.metadata['path']}")
        print(f"!= {expected_path}")
        correct = False


    main_tag = job.metadata['tags'][0]
    if not main_tag.startswith(expected_path):
        main_tag_stem, main_tag_version = main_tag.rsplit('/', 1)

        if not expected_path.endswith(main_tag_stem) or not main_tag_version.startswith('v'):
            print(f"ERROR: Main Tag mismatching path")
            print(f"   {main_tag}")
            print(f"!= {expected_path}")
            correct = False

    wip_items = job.metadata.get("WIP", [])
    if wip_items and _config()["blockers"]["block_on_wip"]:
        print(f"Job has {len(wip_items)} WIP items:")
        for item in wip_items:
            print(f" - {item}")
        correct = False

    # Check git dependencies for uncommitted/unpushed changes
    if check_git:
        all_clean, results = _check_git_dependencies(job, Path(path), repository)
        has_checked_out = any(r.is_checked_out for r in results)

        if has_checked_out:
            print()
            print("Git dependency status:")
            _format_git_check_results(results)

            if not all_clean:
                print("ERROR: Git dependencies have uncommitted or unpushed changes.")
                correct = False

    if correct:
        print("All good.")
    return correct


@cli.command()
@click.option('--color/--no-color', default=None,
              help="Force color output on/off (default: auto-detect)")
@click.option('--structured/--raw', 'structured', default=True,
              help="Show structured output by category (default) or raw diff")
@click.option('--resolved/--no-resolved', 'resolved', default=True,
              help="Show resolved r3.yaml (commits/job IDs) instead of raw (default: resolved)")
@click.option('--stat', 'stat', is_flag=True, default=False,
              help="Show statistics (lines added/deleted per file)")
@click.option('--name-only', 'name_only', is_flag=True, default=False,
              help="Show only names of changed files")
@click.option('-i', '--interactive', 'interactive', is_flag=True, default=False,
              help="Interactive mode - select files to view")
@click.option('--pager/--no-pager', 'use_pager', default=None,
              help="Pipe output through pager (default: auto, enabled for TTY)")
@click.option('--compare-to', 'compare_to', default=None,
              help="Compare to a specific job ID instead of the latest committed version")
@click.argument('path', type=click.Path(exists=True, file_okay=False, path_type=Path))
def diff(color: Optional[bool], structured: bool, resolved: bool, stat: bool, name_only: bool, interactive: bool, use_pager: Optional[bool], compare_to: Optional[str], path: Path) -> None:
    """Show the diff of the job at PATH compared to the latest committed version.

    By default, compares against the latest committed version of the same job.
    Use --compare-to to compare against a specific job ID.
    """
    path = path.resolve()
    repository_path = Path(os.environ["R3_REPOSITORY"])

    if compare_to:
        # Compare to a specific job ID
        compare_job_path = repository_path / "jobs" / compare_to
        if not compare_job_path.exists():
            print(f"Job not found: {compare_to}")
            sys.exit(1)
        previous_job_path = compare_job_path
    else:
        # Compare to the latest committed version
        previous_job = _history(latest=True, path=path, repository_path=repository_path)
        if not previous_job:
            print(f"No previous job found for {path}.")
            sys.exit(1)
        previous_job, = previous_job
        previous_job_path = previous_job.path

    # Build list of paths to exclude: output, __pycache__, all dependency destinations,
    # and anything listed under `ignore:` in r3.yaml
    job = r3.Job(path)
    exclude_patterns = ["output", "__pycache__"]
    for dep in job.dependencies:
        # Get the top-level directory of the destination
        dest = str(dep.destination)
        top_level = dest.split("/")[0] if "/" in dest else dest
        if top_level not in exclude_patterns:
            exclude_patterns.append(top_level)

    # Patterns from r3.yaml `ignore:` are rooted at the job dir (e.g. "/report.html").
    # `diff --exclude=` matches basenames, so strip the leading "/" and take the
    # top-level component.
    for ignore_pattern in job._config.get("ignore", []) or []:
        stripped = ignore_pattern.lstrip("/")
        top_level = stripped.split("/")[0] if "/" in stripped else stripped
        if top_level and top_level not in exclude_patterns:
            exclude_patterns.append(top_level)

    # Get list of changed files (needed for all structured modes)
    changes = xr3diff._get_changed_files(previous_job_path, path, exclude=exclude_patterns)

    # Determine color setting before pager captures stdout
    # If using pager and stdout is TTY, force colors on (pager will handle them)
    is_tty = sys.stdout.isatty()
    if color is None and is_tty:
        color = True  # Force colors when outputting to TTY (pager preserves them with -R)

    if interactive:
        # Interactive mode - select files to view (no pager, has its own interaction)
        xr3diff._interactive_diff(previous_job_path, path, changes, color=color)
    else:
        # Use pager for non-interactive output
        with xr3diff._pager_context(use_pager):
            if name_only:
                # Show only file names
                xr3diff._print_name_only(changes)
            elif stat:
                # Show statistics
                xr3diff._print_stat(previous_job_path, path, changes)
            elif structured:
                # Structured diff output (default)
                xr3diff._print_structured_diff(previous_job_path, path, changes, color=color,
                                       resolved=resolved, repository_path=repository_path)
            else:
                # Raw diff output
                xr3diff.compare_directories(previous_job_path, path, color=color, exclude=exclude_patterns)


@cli.command()
@click.option('-r', "--remove-previous/--no-remove-previous", default=False)
@click.option("-c", "--copy-previous-output/--no-copy-previous-output", default=False)
@click.option('-x', "--exclude-done/--no-exclude-done", default=False)
@click.option('--check/--no-check', default=True, help="Check job (path metadata and buggy dependencies). Defaults to true")
@click.argument("path", type=click.Path(exists=True, file_okay=False, path_type=Path))
@click.argument(
    "repository_path",
    type=click.Path(exists=True, file_okay=False, path_type=Path),
    envvar="R3_REPOSITORY",
)
def commit(remove_previous, copy_previous_output, exclude_done, check: bool, path, repository_path):
    if check:
        correct = _check_job(path, repository_path)
        if not correct:
            print("Job has inconsistencies. Aborted commit, run with --no-check to commit anyway.")
            sys.exit(1)

    repository = r3.Repository(repository_path)
    job = r3.Job(path)

    job = repository.resolve(job)


    previous_job: Optional[r3.Job] = None
    if remove_previous or copy_previous_output:
        print("looking up previous job")
        history = _history(latest=True, path=path, repository_path=repository_path)
        if not history:
            raise ValueError(f"No previous job found for {path}")
        previous_job = history[0]
        print(f"previous job: {previous_job.id} {previous_job.timestamp}")

    print("Commiting")
    job = repository.commit(job)
    print(job.path)

    if copy_previous_output:
        print("copying previous output")
        assert previous_job is not None
        previous_output = previous_job.path / "output"
        output = job.path / "output"
        output.mkdir(exist_ok=True)

        for item in previous_output.iterdir():
            if exclude_done and item.name == "done":
                print("skipping done file")
                continue
            if item.is_dir():
                print("Copying directory", item)
                shutil.copytree(item, output / item.name)
            else:
                print("Copying file", item)
                shutil.copy2(item, output / item.name)

    if remove_previous:
        assert previous_job is not None
        print("deleting previous job", previous_job.path)
        repository.remove(previous_job)


@cli.command(name="dev-checkout")
@click.option('--allow-bugs/--no-allow-bugs', default=False)
@click.argument("path", type=click.Path(exists=True, file_okay=False, path_type=Path))
@click.argument(
    "repository_path",
    type=click.Path(exists=True, file_okay=False, path_type=Path),
    envvar="R3_REPOSITORY",
)
def dev_checkout(allow_bugs: bool, path: str, repository_path: str) -> None:
    repository = r3.Repository(repository_path)

    job = r3.Job(path)
    job = repository.resolve(job)

    missing_dependencies = []
    for dependency in job.dependencies:
        if dependency not in repository:
            print(f"Error: Missing dependency: {dependency}")
            print("destination:", dependency.destination)
            missing_dependencies.append(dependency)

    if missing_dependencies:
            sys.exit(1)

    buggy_dependencies = []
    for dependency in job.dependencies:
        if isinstance(dependency, r3.JobDependency):
            resolved_dependency = repository.resolve(dependency)
            dependency_job = r3.Job(repository.path / 'jobs' / resolved_dependency.job)
            tags = dependency_job.metadata.get("tags", [])
            bug_tags = [tag for tag in tags if any(tag.startswith(p) for p in _config()["blockers"]["tags"])]
            if bug_tags:
                print(f"Bugged dependency for {dependency.destination}:")
                for tag in bug_tags:
                    print(f"- {tag}")
                buggy_dependencies.append(dependency)
    if buggy_dependencies and not allow_bugs:
        print("Bugged dependencies detected, aborting. Continue with --allow-bugs")
        sys.exit(1)

    for dependency in job.dependencies:
        if str(dependency.destination) in _config()["dev_checkout"]["ignored_destinations"]:
            print(f"Skipping {dependency.destination} (ignored destination)")
            continue

        if isinstance(dependency, r3.GitDependency) and dependency.repository in _config()["dev_checkout"]["ignored_repositories"]:  # noqa: E501
            print(f"Skipping {dependency.repository} (ignored repository)")
            continue

        if dependency.destination.exists():
            print(f"Skipping {dependency.destination} (exists)")
            continue

        print("checking out", dependency, dependency.destination)
        repository.checkout(dependency, path)

        if isinstance(dependency, r3.GitDependency):
            git_repo_path = repository.path / dependency.repository_path

            # get-url is too recent...
            #upstream_url = execute(
            #    "git remote get-url origin",
            #    capture=True, directory=git_repo_path
            #)

            output = execute(
                "git remote -v",
                capture=True, directory=git_repo_path
            )

            # just for type checking
            assert isinstance(output, str)
            match = re.search(r"origin\s+(.*)\s+\(fetch\)", output)
            if match is None:
                print("ERROR: Unable to get origin url.")
                continue

            upstream_url = match.group(1)
            print(f"upstream url: {upstream_url}")

            execute(
                f"git remote add upstream {upstream_url}",
                directory=dependency.destination
            )

