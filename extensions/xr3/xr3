    # (in --long) rather than repeating it on every row like `find` does.
    if long and results:
        print(results[0].metadata.get("path", ""))
    for job in results:
        if long:
            datetime_str = job.timestamp.strftime(r"%Y-%m-%d %H:%M:%S")
            tags = " ".join(f"#{tag}" for tag in job.metadata.get("tags", []))
            print(f"  {job.id} | {datetime_str} | {tags}")
        else:
            print(job.path)


@cli.command()
@click.option(
    "--tag", "-t", "tags", multiple=True, type=str,
    help="Only list jobs containing all of the given tags (repeatable).",
)
@click.option(
    "--path", "-p", "path_glob", type=str, default=None,
    help="Match metadata.path against this GLOB pattern. Literal: add * yourself "
         "for substring/prefix matches (e.g. '*Saliency*', 'research/experiments/*'). "
         "(SQLite GLOB: * ? [...] are wildcards)",
)
@click.option(
    "--query", "-q", "queries", multiple=True, type=str,
    help="Arbitrary Mongo-style query as JSON, e.g. '\"tags\": {\"$all\": [\"research\"]}'. "
         "Repeatable; merged into the query (later keys win).",
)
@click.option(
    "--latest/--all", default=False,
    help="Return only the single most recently created job among the matches "
         "(--latest), or all matches (--all, default).",
)
@click.option(
    "--long/--short", "-l", default=False,
    help="Long output: 'id | datetime | path [| tags]' instead of just the job id.",
)
@click.option(
    "--tags/--no-tags", "show_tags", default=True,
    help="Include the tags column in --long output (default: on). Handy since "
         "--path already shows where each job lives.",
)
@click.option(
    "--repository", "repository_path",
    type=click.Path(exists=True, file_okay=False, path_type=Path),
    envvar="R3_REPOSITORY",
)
def find(tags: Iterable[str], path_glob: Optional[str], queries: Iterable[str], latest: bool, long: bool, show_tags: bool, repository_path: Path) -> None:
    """Search the R3 repository for jobs (wraps repository.find).

    Combines --tag (tags $all), --path (metadata.path GLOB), and --query (arbitrary
    JSON) into one AND-ed query. With no options, lists every job.
    """
    repository = r3.Repository(repository_path)
    query = _build_query(tags, queries, path_glob=path_glob)
    for job in repository.find(query, latest):
        if long:
            assert job.timestamp is not None
            datetime_str = job.timestamp.strftime(r"%Y-%m-%d %H:%M:%S")
            path = job.metadata.get("path", "")
            line = f"{job.id} | {datetime_str} | {path}"
            if show_tags:
                tags_str = " ".join(f"#{tag}" for tag in job.metadata.get("tags", []))
                line += f" | {tags_str}"
            print(line)
        else:
            print(job.id)


def _history(latest: bool, path: Path, repository_path: Path) -> list[r3.Job]:
    repository = r3.Repository(repository_path)
    results = []

    origin = _get_path(path)

    # print("origin", origin)

    results = repository.find({
        "path": origin
    }, latest=latest)

    if not latest:
    #    results = [max(results, key=lambda job: job.datetime)]
    #else:
        results = sorted(results, key=lambda job: job.timestamp)

    return results

@functools.lru_cache(maxsize=1)
def _config():
    return xr3config.load_config()


def _get_path(path: Path) -> str:
    """Map a working-directory path to its r3 logical path (from config)."""
    try:
        return xr3pathmap.resolve_job_path(
            Path(path), _config(), config_source=str(xr3config.config_path())
        )
    except xr3pathmap.PathmapError as e:
        raise click.ClickException(str(e))


def _build_query(tags, queries, path_glob=None) -> dict:
    """Build a Mongo-style query dict from tag/path/query CLI options.

    - tags: iterable of tag strings -> {"tags": {"$all": [...]}} (omitted if empty)
    - path_glob: literal GLOB pattern for metadata.path -> {"path": {"$glob": ...}}
    - queries: iterable of JSON fragments; bare `key: value` is wrapped in {...},
      parsed, and merged in. Later keys win (last-writer-wins).
    """
    query: dict = {}
    if tags:
        query["tags"] = {"$all": list(tags)}
    if path_glob is not None:
        query["path"] = {"$glob": path_glob}
    for q in queries:
        if not q.startswith("{"):
            q = f"{{{q}}}"
        query_data = json.loads(q)
        if not isinstance(query_data, dict):
            raise ValueError(f"Query must be a JSON object, got {query_data}")
        query.update(query_data)
    return query


