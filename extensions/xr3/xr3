@dataclass
class GitCheckResult:
    """Result of checking a single git dependency for uncommitted/unpushed changes."""
    dependency: r3.GitDependency
    path: Path
    is_checked_out: bool = False
    has_staged: bool = False
    has_unstaged: bool = False
    has_untracked: bool = False
    current_commit: Optional[str] = None
    expected_commit: Optional[str] = None
    is_clean: bool = True
    issues: List[str] = field(default_factory=list)


def _check_git_dependency(
    dependency: r3.GitDependency,
    job_path: Path,
    repository: r3.Repository,
) -> GitCheckResult:
    """Check a single git dependency for uncommitted or unpushed changes."""
    checkout_path = job_path / dependency.destination
    result = GitCheckResult(dependency=dependency, path=checkout_path)

    # Check if path exists and is a real checkout (not symlink)
    if not checkout_path.exists():
        return result

    if checkout_path.is_symlink():
        return result

    # At this point we have a real directory - mark as checked out
    result.is_checked_out = True

    # Verify it's a git repository - if not, that's unexpected and we should warn
    git_dir = checkout_path / ".git"
    if not git_dir.exists():
        result.issues.append("Directory exists but is not a git repository (missing .git)")
        result.is_clean = False
        return result

    # Check working directory state with git status --porcelain
    try:
        status_output = execute(
            "git status --porcelain",
            directory=checkout_path,
            capture=True
        )
    except ExternalCommandFailed:
        result.issues.append("Failed to get git status")
        result.is_clean = False
        return result

    if status_output and status_output.strip():
        for line in status_output.strip().split('\n'):
            if not line:
                continue
            status_code = line[:2]
            if status_code == '??':
                result.has_untracked = True
            else:
                if status_code[0] != ' ':
                    result.has_staged = True
                if status_code[1] != ' ' and status_code[1] != '?':
                    result.has_unstaged = True

    # Get current HEAD commit
    try:
        current_commit = execute(
            "git rev-parse HEAD",
            directory=checkout_path,
            capture=True
        )
        result.current_commit = current_commit.strip() if current_commit else None
    except ExternalCommandFailed:
        result.issues.append("Failed to get current HEAD commit")
        result.is_clean = False

    # Get expected commit from r3 repository
    try:
        resolved_dependency = repository._resolve_git_dependency(dependency)
        result.expected_commit = resolved_dependency.commit
    except Exception as e:
        result.issues.append(f"Failed to resolve expected commit: {e}")
        result.is_clean = False

    # Build issues list
    if result.has_staged:
        result.issues.append("Has staged changes (not committed)")
        result.is_clean = False

    if result.has_unstaged:
        result.issues.append("Has unstaged changes (modified files)")
        result.is_clean = False

    if result.has_untracked:
        result.issues.append("Has untracked files")
        result.is_clean = False

    if result.current_commit and result.expected_commit:
        if result.current_commit != result.expected_commit:
            result.issues.append(
                f"HEAD ({result.current_commit[:8]}) differs from expected "
                f"({result.expected_commit[:8]}). Changes may not be pushed to upstream."
            )
            result.is_clean = False

    return result


def _check_git_dependencies(
    job: r3.Job,
    job_path: Path,
    repository: r3.Repository,
) -> tuple[bool, List[GitCheckResult]]:
    """
    Check all git dependencies for uncommitted/unpushed changes.

    Returns:
        Tuple of (all_clean, results) where all_clean is True if no issues found.
    """
    results = []
    all_clean = True

    for dependency in job.dependencies:
        if not isinstance(dependency, r3.GitDependency):
            continue

        result = _check_git_dependency(dependency, job_path, repository)
        results.append(result)

        if result.is_checked_out and not result.is_clean:
            all_clean = False

    return all_clean, results


def _format_git_check_results(
    results: List[GitCheckResult],
    verbose: bool = False
) -> None:
    """Print formatted output of git dependency check results."""
    checked_out_results = [r for r in results if r.is_checked_out]

    if not checked_out_results:
        print("No git dependencies are checked out locally.")
        return

    print(f"Checked {len(checked_out_results)} git dependencies:")
    print()

    for result in checked_out_results:
        status_icon = "OK" if result.is_clean else "WARN"
        print(f"  [{status_icon}] {result.dependency.destination}")

        if not result.is_clean:
            for issue in result.issues:
                print(f"       - {issue}")

            # Provide actionable advice
            if result.has_staged or result.has_unstaged:
                print(f"       Action: Commit your changes in {result.path}")
            if result.current_commit and result.expected_commit and result.current_commit != result.expected_commit:
                print("       Action: Push your changes to upstream (not origin)")

        if verbose:
            print(f"       Current commit: {result.current_commit or 'unknown'}")
            print(f"       Expected commit: {result.expected_commit or 'unknown'}")

        print()


