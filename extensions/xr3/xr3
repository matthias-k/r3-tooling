@click.argument("job_ids", type=click.UUID, nargs=-1)
@click.option("--dry/--no-dry", default=False)
@click.option("--check-existing-jobs/--no-check-existing-jobs", default=False, help="Check if job is already submitted.")
@click.option("-r", "--restart-failed/--no-restart-failed", default=False)
@click.option("--cluster", "-c", type=str, default="galvani")
@click.option("-o", "--observe/--no-observe", default=False)
def submit_jobs(job_ids, dry: bool = False, check_existing_jobs: bool = False, restart_failed: bool = False, cluster: str = "galvani", observe: bool = False):
    repository_path = os.environ["R3_REPOSITORY"]
    repository = r3.Repository(repository_path)
    if len(job_ids) > 1 and observe:
        raise ValueError("Can't observe multiple jobs at once.")

    for job_id in job_ids:
        job_path = repository.path / "jobs" / str(job_id)
        _submit_job(job_path, dry=dry, check_existing_jobs=check_existing_jobs, restart_failed=restart_failed, cluster=cluster, observe=observe)




def _submit_job(path: Path, dry: bool = False, check_existing_jobs: bool = False, observe: bool = False, restart_failed: bool = False, cluster=None, verbose: int = 0, partition: Optional[str] = None, mem: Optional[str] = None) -> bool:
    path = path.absolute()

    if (path / "output" / "done").is_file():
        if verbose >= 3:
            print("Job is done already.")
        with (path / "output" / "done").open() as f:
            done_state = f.read()

        if done_state.strip() == "restart":
            # workaround for QB problems where we can't delete the done file reliably across nodes :(((((
            if verbose >= 3:
                print("restart requested")
        elif (done_state.strip() == "failed") and restart_failed:
            if verbose >= 2:
                print("restarting failed job")
            # TODO: once we got rid of QB, simply delete the file
            if not dry:
                with (path / "output" / "done").open(mode='w') as f:
                        f.write("restart\n")
        else:
            return False

    script = path / "run.sh"
    if not script.exists():
        raise ValueError("No run script.")


    full_id = path.name
    try:
        uuid.UUID(full_id)
    except ValueError:
        raise ValueError("Job directory is not a valid UUID.")

    if check_existing_jobs:
        squeue_command = make_external_command(cluster, f"squeue --noheader --name={full_id}", capture=True)
        squeue_command.start()
        squeue_output = squeue_command.output
        if squeue_output.strip():
            if verbose >= 3:
                print("Job is already in queue:")
                print(squeue_output)
            return False

    with script.open() as f:
        script_content = f.read()

    sbatch_options = [line for line in script_content.split('\n') if line.startswith('#SBATCH')]
    sbatch_options = [line[len('#SBATCH'):].strip() for line in sbatch_options]
    is_array_job = any(line.startswith('--array') for line in sbatch_options)

    if is_array_job:
        output_path = path / "output" / "slurm_%A_%a.log"
    else:
        output_path = path / "output" / "slurm_%J.log"

    options = {
        "--job-name": full_id,
        "--comment": path,
        "--chdir": path,
        "--output": output_path,
        "--error": output_path,
        "--exclude": "galvani-cn221,galvani-cn240",
    }
    if partition is not None:
        options["--partition"] = partition
    if mem is not None:
        options["--mem"] = mem
    options_str = " ".join(f"{key}={value}" for key, value in options.items())

    command = f"sbatch {options_str} {script}"
    # print(command)

    if dry:
        if verbose >= 1:
            print(f"Would submit job {full_id}.")
        #print(command)
        return True
    else:
        os.makedirs(path / "output", exist_ok=True)
        command = make_external_command(cluster, command, capture=True)
        print(command)
        command.start()
        output = command.output
        print(output)

        if observe:
            match = re.match(r"^Submitted batch job (.*)$", output)
            if not match:
                print("Observing failed: Unable to get job id from job.")
            else:
                job_id = match.group(1)
                print("Sleeping for 5s before attaching...")
                time.sleep(5)
                if False:  # cluster is not None:
                    sattach_cmd = RemoteCommand(cluster, f"sattachx_wait {job_id}")
                else:
                    sattach_cmd = ExternalCommand(f"sattachx_wait {job_id}")
                #execute(f"sattachx {job_id}")
                sattach_cmd.start()
        return True


def check_for_slurm_job(job_id):
    for cluster in HEADNODES:
        cmd = RemoteCommand(cluster, f"squeue --me --noheader --format=%i --name={job_id}", capture=True)
        cmd.start()
        squeue_output = cmd.output
        if squeue_output.strip():
            return (cluster, squeue_output)

    return None, None


def get_all_slurm_jobs():
    """returns list of (cluster, job_name, job_id, job_state)"""
    all_jobs = []
    for cluster in HEADNODES:
        cmd = RemoteCommand(cluster, "squeue --me --noheader --format='%j|%i|%T'", capture=True)
        cmd.start()
        squeue_output = cmd.output
        for line in squeue_output.split('\n'):
            if not line.strip():
                continue
            job_name, job_id, job_state = line.split('|')
            all_jobs.append((cluster, job_name, job_id, job_state))
    return all_jobs


@cli.command()
@click.argument("tags", nargs=-1)
@click.option('--newest', 'selection', flag_value='newest',
              default=True)
@click.option('--oldest', 'selection', flag_value='oldest')
@click.option('--oldest-running-job', 'selection', flag_value='oldest-running-job')
@click.option('--newest-running-job', 'selection', flag_value='newest-running-job')
def watch(tags, selection: str):
    _watch(tags, selection)

def _watch(tags, selection: str):
    repository_path = os.environ["R3_REPOSITORY"]
    repository = r3.Repository(repository_path)
    last_state = None
    last_state_change = datetime.now()
    while True:
        query = { 'tags': { '$all': tags} }
        jobs = repository.find(query=query)
        if not jobs:
            if last_state != 'no_jobs_found':
                last_state = 'no_jobs_found'
                last_state_change = datetime.now()

            time_since_last_state_change = datetime.now() - last_state_change
            print(f"No jobs found for {time_since_last_state_change}\r", end='', flush=True)
            sleep(10)
            continue

        print(f"found {len(jobs)} matching r3 jobs")

        if selection == 'oldest':
            job = jobs[0]
        elif selection == 'newest':
            job = jobs[-1]
        elif selection in ['oldest-running-job', 'newest-running_job']:
            all_cluster_jobs = get_all_slurm_jobs()
            all_cluster_jobs = sorted(all_cluster_jobs, key=lambda x: int(x[2]))
            if selection == 'newest-running-job':
                all_cluster_jobs = reversed(all_cluster_jobs)

            all_job_ids = {job.id: job for job in jobs}
            matching_cluster_jobs = [entry for entry in all_cluster_jobs if entry[1] in all_job_ids]
            print(f"found ({len(matching_cluster_jobs)}) jobs in clusters")
            running_cluster_jobs = [entry for entry in matching_cluster_jobs if entry[-1] == 'RUNNING']
            print(f"found ({len(running_cluster_jobs)}) running jobs in clusters")

            if not running_cluster_jobs:
                sleep(10)
                continue

            cluster, job_name, job_id, job_state = running_cluster_jobs[0]
            job = all_job_ids[job_name]
        else:
            raise ValueError("Invalid selection.")
        print(f"Attaching to job {job.id}...")
        for tag in job.metadata['tags']:
            print(f'- {tag}')
        sleep(5)
        cluster, slurm_id = check_for_slurm_job(job.id)

        if cluster is None:
            if last_state != 'job_not_in_queue':
                last_state = 'job_not_in_queue'
                last_state_change = datetime.now()
            time_since_last_state_change = datetime.now() - last_state_change
            print(f"Job not found in queue for {time_since_last_state_change}\r", end='', flush=True)
            sleep(10)
            continue

        if last_state != 'jobs_in_queue':
            last_state = 'jobs_in_queue'
            last_state_change = datetime.now()


        print(f"Attaching to job {slurm_id} on {cluster}...")
        # sattach_cmd = RemoteCommand(cluster, f"/home/bethge/mkuemmerer31/.local/bin/sattachx_wait {slurm_id}")
        sattach_cmd = ExternalCommand(f"/home/bethge/mkuemmerer31/.local/bin/sattachx_wait {slurm_id}")
        try:
            sattach_cmd.start()
        except ExternalCommandFailed as e:
            print("sattach failed")
            sleep(10)
            continue

        print("Waiting")
        sleep(10)



@cli.command()
@click.option('--summary/--no-summary', default=True)
@click.option('--details/--no-details', default=True)
@click.argument("tags", nargs=-1)
def status(summary, details, tags):
    repository_path = os.environ["R3_REPOSITORY"]
    repository = r3.Repository(repository_path)
    #query = { 'tags': { '$all': tags} }
    query = {
        '$and': [
            {
                'tags': {
                    '$glob': tag
                }
            } for tag in tags
        ]
    }
    jobs = repository.find(query=query)

    if not jobs:
        print("No jobs found.")
        return

    running_jobs = {}
    for cluster in HEADNODES:
        cmd = RemoteCommand(cluster, "squeue --me --noheader --format='%j|%i|%T'", capture=True)
        cmd.start()
        squeue_output = cmd.output
        for line in squeue_output.split('\n'):
            if not line.strip():
                continue
            job_name, job_id, job_state = line.split('|')
            running_jobs[job_name] = (job_id, job_state)


    def check_job_status(job: r3.Job):
        job_done_file = job.path / 'output' / 'done'

        if job_done_file.is_file():
            with job_done_file.open() as f:
                done_state = f.read()
            if done_state.strip() == 'restart':
                state = 'restart'
            elif done_state.strip() == 'failed':
                state = 'failed'
            else:
                state = 'done'
        else:
            state = ''

        cluster_job_id, cluster_state = running_jobs.get(job.id, (None, None))

        return state, cluster_job_id, cluster_state

    def remove_common_prefix(strings: List[str]) -> List[str]:
        """remove as much as possible from shared beginning from all strings"""
        if not strings:
            return strings

        for i in range(len(strings[0])):
            if not all(s.startswith(strings[0][:i]) for s in strings):
                break

        return [s[i-1:] for s in strings]


    job_names = remove_common_prefix([job.metadata['tags'][0] for job in jobs])

    data = []

    for job, job_name in zip(tqdm(jobs, delay=10), job_names):
        state, cluster_job_id, cluster_state = check_job_status(job)
        data.append({
            'job_name': job_name,
            'job_state': state,
            'cluster_job_id': cluster_job_id,
            'cluster_state': cluster_state,
        })

    if summary:
        summary_states = []
        for item in data:
            item_data = []
            for state_name in ['job_state', 'cluster_state']:
                if item[state_name]:
                    item_data.append(item[state_name])
            summary_states.append('-'.join(item_data))

        states = Counter(summary_states)

        for key, value in states.items():
            print(f"{key}: {value}")


    if details:

        for item in sorted(data, key=lambda item: item['job_name']):
            job_name = item['job_name']
            state = item['job_state']
            cluster_job_id = item['cluster_job_id']
            cluster_state = item['cluster_state']
            print(f"{job_name}: {state} {cluster_job_id if cluster_job_id is not None else ''} {cluster_state if cluster_state is not None else ''}")


def make_external_command(cluster: Optional[str], command: str, **kwargs):
#    if cluster == 'galvani':
#        cluster = 'galvani-lustre'
    if cluster is not None:
        return RemoteCommand(cluster, command, **kwargs)
    else:
        return ExternalCommand(command, **kwargs)

